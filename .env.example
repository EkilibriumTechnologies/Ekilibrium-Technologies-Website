# Server-side n8n webhook for Rental Tech Audit lead intake.
# Never expose this URL to the browser. Do not prefix with NEXT_PUBLIC_.
CONTACT_N8N_WEBHOOK_URL=

# Optional shared secret sent to n8n as the X-Ekilibrium-Webhook-Secret header.
# Never expose this secret to the browser. Do not prefix with NEXT_PUBLIC_.
CONTACT_WEBHOOK_SECRET=
